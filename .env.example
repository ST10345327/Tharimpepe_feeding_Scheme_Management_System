DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fsms
DB_USERNAME=root
# Leave empty for XAMPP default local root user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Trust forwarded HTTPS only when PHP receives the request from this local reverse proxy.
# For Tailscale Serve forwarding to http://127.0.0.1:8080, configure the PHP server
# process environment with FSMS_TRUSTED_PROXIES=127.0.0.1. This file is an example;
# the application does not load .env files automatically.
FSMS_TRUSTED_PROXIES=

# Public Google OAuth client IDs. Use the web client ID as the ID-token audience
# for both Google Identity Services and Android Credential Manager.
GOOGLE_WEB_CLIENT_ID=
# Informational only: configure this client in Google Cloud with the Android
# package name and signing certificate SHA-1; do not use it as the server audience.
GOOGLE_ANDROID_CLIENT_ID=

# Email verification delivery. SendGrid single-sender verification can be used
# for trial testing without DNS access; use domain authentication for production.
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tharimpepe Feeding Scheme

# SMS OTP provider. Twilio trial can send only to recipient numbers verified in Twilio.
SMS_PROVIDER=mock
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# PayFast hosted checkout and ITN verification.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=https://localhost/fsms/public/index.php?action=donations_success
PAYFAST_CANCEL_URL=https://localhost/fsms/public/index.php?action=donations_cancel
PAYFAST_NOTIFY_URL=https://localhost/fsms/public/index.php?action=payfast_itn
