DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fsms
DB_USERNAME=root
# Leave empty for XAMPP default local root user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Public Google OAuth client IDs. Use the web client ID as the ID-token audience
# for both Google Identity Services and Android Credential Manager.
GOOGLE_WEB_CLIENT_ID=
# Informational only: configure this client in Google Cloud with the Android
# package name and signing certificate SHA-1; do not use it as the server audience.
GOOGLE_ANDROID_CLIENT_ID=
